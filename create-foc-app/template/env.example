# Filecoin network: "calibration" (testnet) or "mainnet"
FOC_NETWORK=calibration

# Wallet private key (0x-prefixed hex). Never commit this file.
# This wallet pays for gas (FIL) and storage (USDFC).
FOC_PRIVATE_KEY=

# Request source tag shown in Synapse telemetry
FOC_APP_NAME=my-foc-app

# ── Faucets (calibration testnet) ─────────────────────────────
#   tFIL (gas):       https://faucet.calibnet.chainsafe-fil.io
#   tUSDFC (storage): https://forest-explorer.chainsafe.dev/faucet/calibnet_usdfc
# Docs: https://docs.filecoin.cloud

